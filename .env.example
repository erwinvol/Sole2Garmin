# Ingestion Provider: "cloud" (Dyaco / SOLE+ API), "strava", or "local"
INGESTION_PROVIDER=cloud

# Sole / Dyaco Credentials (Option B: Direct SOLE+ Cloud API)
SOLE_EMAIL=your_sole_email@example.com
SOLE_PASSWORD=your_sole_password
SOLE_BASE_URL=https://sole-homeplus.dyacocloud.com

# (Optional) Strava Credentials (if using Strava bridge instead)
# STRAVA_CLIENT_ID=your_strava_client_id
# STRAVA_CLIENT_SECRET=your_strava_client_secret
# STRAVA_REFRESH_TOKEN=your_strava_refresh_token
# STRAVA_FILTER_SOLE_ONLY=true

# Garmin Connect Credentials
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Storage paths
DATA_DIR=data
GARMIN_TOKEN_DIR=data/garmin_tokens
STRAVA_TOKEN_DIR=data/strava_tokens
SAMPLE_DIR=data/sample_activities

# Sync Configuration
SYNC_INTERVAL_MINUTES=60
SYNC_BATCH_SIZE=10
CHECK_DUPLICATES=true
DUPLICATE_THRESHOLD_HOURS=2

# Device Spoofing (3943: Epix Gen 2, 4315: Forerunner 965, 3927: Edge 1040)
SPOOF_GARMIN_DEVICE=true
DEVICE_PRODUCT_ID=3943
DEVICE_SOFTWARE_VERSION=18.16
# Activity classification (Walk vs Run threshold in km/h)
# Average speed <= WALK_RUN_THRESHOLD_KMH is tagged as Walking (Sport: WALKING, SubSport: GENERIC)
# Average speed > WALK_RUN_THRESHOLD_KMH is tagged as Indoor Running (Sport: RUNNING, SubSport: INDOOR_RUNNING)
# Set to 0 to disable auto-tagging
WALK_RUN_THRESHOLD_KMH=6.0

# Timezone for local wall-clock interpretation and Garmin Connect synchronization (e.g. America/New_York)
TIMEZONE=America/New_York
TZ=America/New_York

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
